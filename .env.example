
# Copy this file to .env.local and enter values from your own projects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_DATABASE_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only. Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLOUDINARY_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=# Server-only Supabase secret (service role) key, used by the super-admin portal
# for password and sign-in changes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only. Verifies the abuse-report form's Turnstile token; leave empty to rely on rate limits alone.
TURNSTILE_SECRET_KEY=
# Server-only. Random string (16+ chars); Vercel Cron sends it as a Bearer token to /api/cron/maintenance.
CRON_SECRET=
# Server-only. 32 random bytes, base64 (openssl rand -base64 32). Encrypts RestroFuel POS link secrets.
RESTROFUEL_LINK_KEY=
